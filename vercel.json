{
  "version": 2,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/images/$1"
    },
    {
      "src": "/favicon.ico",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
